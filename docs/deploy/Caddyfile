gpt-image2.zero2codex.dev {
	encode gzip zstd

	@api path /api /api/*
	handle @api {
		# The community QR upload is limited to 2 MiB by the application. Keep
		# enough headroom for request framing and future API payloads.
		request_body {
			max_size 8MB
		}

		# API responses include user data and payment/account state.
		header {
			Cache-Control "no-store, private, max-age=0"
			Pragma "no-cache"
		}

		reverse_proxy 127.0.0.1:4174
	}

	# Serve the Vite build directly. try_files sends client-side routes such as
	# /community and /community/result to the SPA entry point.
	handle {
		root * /var/www/gpt-image2/dist
		try_files {path} /index.html
		file_server
	}
}
