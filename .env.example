ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
# Legacy paid-community backend compatibility; the public website links to Discord instead.
COMMUNITY_ALIPAY_NOTIFY_URL=
# Set to false only for local production-parameter acceptance without a public HTTPS callback.
ALIPAY_NOTIFY_ENABLED=true

# Legacy paid-community backend: keep disabled unless you explicitly re-enable it.
